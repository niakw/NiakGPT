{
  "manifest_version": 3,
  "name": "NiakGPT",
  "version": "0.8.0",
  "description": "Workspace power-user local pour ChatGPT : Projects, tri automatique, Quick Open, prompts adaptatifs, DA forcée et indexation idle-safe.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["theme-v08.css"],
      "js": ["app-v08-safe.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "NiakGPT"
  }
}

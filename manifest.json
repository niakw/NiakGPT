{
  "manifest_version": 3,
  "name": "NiakGPT",
  "version": "0.9.11",
  "description": "Workspace power-user local pour ChatGPT : cœur event-driven, cache chaud, Projects instantanés, coach contextuel, panneaux natifs adaptés, multi-onglets et états temps réel.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "background-v100.js"},
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["theme-v08.css","polish-v081.css","chronology-v081.css","multitab-v083.css","governance-v085.css","activity-v086.css","control-center-v090.css","core-v090.css","profiles-v100.css","commands-v100.css","onboarding-v100.css","coach-v100.css","pin-folders-v096.css","side-panels-v096.css"],
      "run_at": "document_start",
      "js": []
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["boot-gate-v100.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["retro-loader-v097.css"],
      "run_at": "document_start",
      "js": []
    }
  ],
  "action": {"default_title":"NiakGPT","default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png"}},
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"}
}

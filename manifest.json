{
  "manifest_version": 3,
  "name": "NiakGPT",
  "version": "0.6.0",
  "description": "Workspace power-user local pour ChatGPT : Projects, tri automatique, navigation rapide, prompts adaptatifs, performance et direction artistique.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["theme-v06.css"],
      "js": ["app-v06.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "NiakGPT"
  }
}

{
  "manifest_version": 3,
  "name": "NiakGPT",
  "version": "0.9.110",
  "description": "NiakGPT : boot React résilient aux recoverable #418, HostRoot courant post-recovery, zéro mutation pré-hydratation.",
  "permissions": [
    "storage",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://api.github.com/*",
    "https://github.com/login/*",
    "https://lopeiincnbjihmoahcbogokeniojgobk.chromiumapp.org/*"
  ],
  "background": {
    "service_worker": "background-v100.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "boot-gate-v100.js",
        "composer-continuation-v128.js",
        "long-run-watchdog-v129.js",
        "pin-interaction-rescue-v129.js",
        "project-menu-augment-v129.js",
        "continuity-native-handoff-v129.js"
      ],
      "run_at": "document_idle"

{
  "manifest_version": 3,
  "name": "NiakGPT",
  "version": "0.9.6",
  "description": "Workspace power-user local pour ChatGPT : cœur event-driven, cache chaud, Projects instantanés, coach contextuel, panneaux natifs adaptés, multi-onglets et états temps réel.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background-v100.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "page-bridge.js",
        "manual-lock-main-v085.js",
        "activity-main-v087.js",
        "hotcache-main-v084.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "theme-v08.css",
        "polish-v081.css",
        "chronology-v081.css",
        "multitab-v083.css",
        "governance-v085.css",
        "activity-v086.css",
        "control-center-v090.css",
        "core-v090.css",
        "profiles-v100.css",
        "commands-v100.css",
        "onboarding-v100.css",
        "coach-v100.css",
        "pin-folders-v096.css",
        "side-panels-v096.css"
      ],
      "js": [
        "onboarding-v101.js",
        "profiles-v100.js",
        "control-center-v090.js",
        "cache-bus-v096.js",
        "commands-v100.js",
        "multitab-v090.js",
        "project-governance-v090.js",
        "project-pins-v090.js",
        "sidebar-host-v090.js",
        "app-v090.js",
        "coach-v100.js",
        "polish-v090.js",
        "side-panels-v096.js",
        "chronology-v090.js",
        "pin-folders-v096.js",
        "hotcache-v084.js",
        "activity-v086.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "NiakGPT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

{
  "manifest_version": 3,
  "name": "NiakGPT",
  "version": "0.4.0",
  "description": "Workspace power-user local pour ChatGPT : organisation, navigation, prompts adaptatifs, sommaire, performance et direction artistique.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["styles.css", "theme-vscode.css"],
      "js": ["content.js", "smart.js", "visual.js", "matrix.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NiakGPT"
  }
}

{
  "manifest_version": 3,
  "name": "NiakGPT",
  "version": "0.7.0",
  "description": "Workspace power-user local pour ChatGPT : indexation complète des Projects et conversations, tri automatique, Quick Open, prompts adaptatifs, performance et DA NiakGPT.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["theme-v07.css"],
      "js": ["app-v07.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "NiakGPT"
  }
}
